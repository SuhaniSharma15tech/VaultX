# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Prisma migrations / direct TCP when port 5432 is open)
DATABASE_URL="postgresql://vaultx:vaultx_dev_password@localhost:5432/vaultx?schema=public"

# Supabase HTTPS Data API (works over port 443 even when port 5432 is blocked)
SUPABASE_URL="https://ppagxundluxprehiykss.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_secret_key_here"
SUPABASE_BUCKET="Vaultx-blobs"

# JWT Auth
JWT_SECRET="replace-with-a-long-random-64-char-secret"
JWT_EXPIRES_IN="7d"

# Storage
SUPABASE_URL="https://ppagxundluxprehiykss.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_copied_key_here"
SUPABASE_BUCKET="your-private-bucket-name"
MAX_FILE_SIZE_BYTES=104857600
